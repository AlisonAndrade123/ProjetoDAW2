<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.1"
             xmlns="https://jakarta.ee/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd">

    <persistence-unit name="daw" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>br.edu.ifpb.es.daw.entities.Usuario</class>
        <class>br.edu.ifpb.es.daw.entities.Papel</class>
        <class>br.edu.ifpb.es.daw.entities.Endereco</class>
        <class>br.edu.ifpb.es.daw.entities.Categoria</class>
        <class>br.edu.ifpb.es.daw.entities.Produto</class>
        <class>br.edu.ifpb.es.daw.entities.Pedido</class>
        <class>br.edu.ifpb.es.daw.entities.ItemPedido</class>

        <properties>

            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver" />
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5433/mini_mundo_db" />
            <property name="jakarta.persistence.jdbc.user" value="minimundo_user" />
            <property name="jakarta.persistence.jdbc.password" value="minimundo_pwd" />

            <!-- HIBERNATE -->
            <property name="hibernate.hbm2ddl.auto" value="update" />
            <property name="hibernate.show_sql" value="true" />
            <property name="hibernate.format_sql" value="true" />
            <property name="hibernate.use_sql_comments" value="true" />

            <property name="hibernate.default_schema" value="public" />
            <property name="hibernate.c3p0.min_size" value="5" />
            <property name="hibernate.c3p0.max_size" value="20" />
            <property name="hibernate.c3p0.timeout" value="3000" />
            <property name="hibernate.c3p0.max_statements" value="50" />
            <property name="hibernate.c3p0.idle_test_period" value="300" />

        </properties>
    </persistence-unit>
</persistence>